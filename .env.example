# 复制为 .env 后填写。切勿把真实 .env 提交进版本库。
# JWT 签名密钥，至少 32 字符随机串（如 `openssl rand -base64 48`）
JWT_SECRET_KEY=
# SQLite 连接串
DATABASE_URL=sqlite+aiosqlite:///./data/inventory.db
# 首次启动创建管理员（两变量同时提供才生效；已存在同名用户会重置其密码）
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 上传上限，字节
MAX_UPLOAD_SIZE=20971520

# ── 新栈（Rust / axum，2026-11 起）──────────────────────────────
# 监听地址
STEELPIPE_BIND=127.0.0.1:8080
# SQLite 连接串；数据库目录必须可写
STEELPIPE_DATABASE_URL=sqlite://data/steelpipe.db
# JWT 密钥，至少 32 字节（openssl rand -base64 48）；为空时拒绝启动
STEELPIPE_JWT_SECRET=
# 连接池上限
STEELPIPE_MAX_CONNECTIONS=10
# 请求体上限，字节（对齐旧 MAX_UPLOAD_SIZE = 20 MiB）
STEELPIPE_MAX_BODY_BYTES=20971520
# 仅当反代会覆盖客户端传入的 X-Forwarded-For 时开启；默认不信任转发头
STEELPIPE_TRUST_FORWARDED_HEADERS=false
