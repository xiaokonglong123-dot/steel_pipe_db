# ─── 数据库 ───────────────────────────────────────────────
# SQLite 连接字符串。mode=rwc 表示读写创建模式（文件不存在时自动创建）。
# 生产环境：确保 data/ 目录已持久化并定期备份。
DATABASE_URL=sqlite://./data/steel_pipe.db?mode=rwc

# ─── 运行环境 ─────────────────────────────────────────────
# 部署环境：development（默认）或 production。
# 设为 production 时，若 JWT_SECRET 缺失、仍为下方占位值、或短于 32 字节，
# 服务将拒绝启动（fail-closed），防止用弱密钥签发可被伪造的令牌。
APP_ENV=development

# ─── 初始管理员 ───────────────────────────────────────────
# 首次启动时（数据库无用户）自动创建管理员。仅在空库时生效。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── JWT 认证 ─────────────────────────────────────────────
# JWT 签名的 HMAC 密钥。生产环境必须修改！至少 32 字节。
# 生成方式：openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret

# JWT 令牌过期时间（小时）。默认：24（一天）
JWT_EXPIRY_HOURS=24

# Refresh token 过期时间（天）。默认：30
REFRESH_TOKEN_EXPIRY_DAYS=30

# ─── 服务器 ───────────────────────────────────────────────
# HTTP 服务器绑定的网络接口。默认：0.0.0.0（所有接口）
# 生产环境建议设为 127.0.0.1（仅本地，配合反向代理使用）
SERVER_HOST=0.0.0.0

# HTTP 服务器端口。默认：3000
SERVER_PORT=3000

# ─── CORS 跨域 ─────────────────────────────────────────────
# 允许的前端域名，多个用逗号分隔。默认：http://localhost:5173（Vite 开发服务器）
# 生产环境示例：https://pipe.example.com,https://pipe2.example.com
CORS_ORIGINS=http://localhost:5173

# ─── 部署 ─────────────────────────────────────────────────
# HTTP 服务器端口（仅影响独立运行模式，Docker 中通过 docker-compose 配置）
HTTP_PORT=80

# ─── 备份 ─────────────────────────────────────────────────
# 备份保留天数（默认：7天）
RETENTION_DAYS=7

